Options -Indexes
DirectoryIndex index.html

# =====================================================================
#  PFG — katalog główny app.pfgfootball.com  (wersja z audytu 19.10.2026)
#  1) przekierowania starych adresów aplikacji pod /coach/
#  2) blokada plików, które nie powinny być publiczne
#  3) podstawowe nagłówki bezpieczeństwa dla całej domeny
#  4) cache i kompresja (aktualizacja 28.10.2026 — audyt sync/mobile):
#     pliki z /assets/ mają własne /assets/.htaccess (cache na rok),
#     tu: manifesty bez cache, ikony i zrzuty z /brand/ na tydzień.
#
#  CSP: strona główna ma własną CSP w znaczniku <meta>, aplikacje w
#  /coach/ dostają CSP z /coach/.htaccess, a /share/ z /share/.htaccess.
# =====================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Zawsze HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Pliki ukryte (.git, .env, .DS_Store …) — poza .well-known (certyfikaty SSL)
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\. - [F,L]

  # sw.js zostaje na starym miejscu — to wyłącznik starego Service Workera
  RewriteCond %{REQUEST_URI} !/sw\.js$
  RewriteRule ^training(/.*)?$ /coach/training$1 [R=302,L]
  RewriteCond %{REQUEST_URI} !/sw\.js$
  RewriteRule ^tactics(/.*)?$ /coach/tactics$1 [R=302,L]
</IfModule>

# Archiwa, kopie zapasowe, mapy źródeł i pliki konfiguracyjne nie są serwowane,
# nawet jeśli ktoś je przypadkiem wgra na serwer.
<FilesMatch "\.(zip|rar|7z|tar|gz|tgz|bak|old|orig|swp|sql|map|env|log|ini|md|ts|tsx)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<FilesMatch "^(index-hostido\.html|_headers|_redirects|package(-lock)?\.json|composer\.(json|lock))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # HSTS: przeglądarka przez rok łączy się z tą domeną wyłącznie przez HTTPS.
  # Wymaga ważnego certyfikatu SSL dla app.pfgfootball.com (Hostido: Let's Encrypt).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Ukrycie wersji serwera/PHP (o ile hosting pozwala)
  Header always unset X-Powered-By
  Header unset X-Powered-By

  # „Header set” (bez „always”), żeby /coach/.htaccess i /share/.htaccess mogły ten nagłówek
  # nadpisać zamiast dopisywać drugi Cache-Control.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Wszystkie manifesty PWA (manifest.webmanifest i manifest-planner/-tactics/-training)
  # oraz wyłączniki starych Service Workerów — zawsze sprawdzane na serwerze.
  <FilesMatch "^(sw\.js|manifest(-[a-z]+)?\.webmanifest)$">
    Header always set Cache-Control "no-cache"
  </FilesMatch>

  # Ikony, zrzuty ekranu i fonty bez hasha w nazwie — tydzień.
  # Przy zmianie grafiki pod tą samą nazwą przeglądarki pobiorą ją najpóźniej po 7 dniach.
  <FilesMatch "\.(png|webp|jpg|jpeg|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>

# Kompresja tekstu (LiteSpeed w Hostido zwykle kompresuje sam — ta sekcja nie szkodzi).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json application/manifest+json image/svg+xml application/xml
</IfModule>
